# OPERATOR AI OS - JARVIS
#
# Copy this file to `.env` and fill it in. `.env` is git-ignored and must never
# be committed. No API key belongs anywhere else in this repository.
#
#   cp .env.example .env

# --- model providers -------------------------------------------------------
# The Claude key. Required for anything real.
# The only credential the system needs. Create one at console.anthropic.com,
# put it here, and keep this file out of git — .gitignore already does that.
# The account it belongs to also needs credit: a valid key on an empty account
# is refused with HTTP 400, not 401, and `jarvis smoke` tells those apart.
#
# Nothing in this repository ever reads a key from source, prints one, or
# writes one to a log. Run `jarvis smoke` after setting it.
ANTHROPIC_API_KEY=

# A second vendor, and the only thing that makes routing *quality* measurable:
# with one provider every model succeeds and fails together, so there is nothing
# to compare. NVIDIA NIM speaks Chat Completions, so it reuses the OpenAI
# provider with a different base URL. Both must be set, like OPENAI_*, because a
# catalogue of hundreds changes faster than this code should.
#   NVIDIA_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_API_KEY=
NVIDIA_MODEL=

# xAI and Gemini, same mechanism. Gemini goes through Google's
# OpenAI-compatibility endpoint rather than its native API — one request format
# for every non-Anthropic vendor, at the cost of Gemini-specific features.
#   XAI_MODEL=grok-4-fast
#   GEMINI_MODEL=gemini-2.5-flash
XAI_API_KEY=
XAI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=

# Optional second opinion. Both must be set for the OpenAI provider to load.
OPENAI_API_KEY=
OPENAI_MODEL=

# --- the free tier: models already on this machine --------------------------
#
# Ollama needs no key and costs nothing, so it is the only provider configured
# by absence: leave all of this alone and it is used if the daemon is running
# and ignored if it is not. Install from ollama.com, then:
#
#   ollama pull qwen2.5:7b        # a good default for the simple, high-volume steps
#   ollama list                   # what this machine has
#   jarvis models                 # what JARVIS will use, and at what price
#
# Every pulled model becomes a $0 entry in the catalogue automatically; there is
# nothing to add to config/models.json. They enter the `fast` tier, which is
# where classification, extraction and routing go — and where every other tier
# steps down to once 70% of the day's budget is spent. That is the point: the
# budget ceiling becomes a change of gear instead of a wall.
#
# Planning, synthesis, coding and high-value work are never routed here, whatever
# OLLAMA_TIER says. A free model must not win that work by being free.
OLLAMA_ENABLED=1
# Pin one model instead of using everything installed. Optional.
#   OLLAMA_MODEL=qwen2.5:7b
OLLAMA_MODEL=
# Only change this to reach a daemon on another machine — and know that the
# prompt then leaves this one. The log says so, once, when it does.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# --- storage ---------------------------------------------------------------
# Where durable state lives: tasks, memory, approvals, audit, cost.
# Leave it unset and everything stays in memory, which is fine for a quick run
# and wrong for anything overnight: an approval raised by a night shift can
# only be decided from another terminal when this is set.
JARVIS_DATABASE_PATH=var/jarvis.db

# --- environment -----------------------------------------------------------
# sandbox | staging | production
# The sandbox refuses money, deploys and admin rights whatever an agent asks for.
JARVIS_ENVIRONMENT=sandbox
JARVIS_LOG_LEVEL=INFO

# --- budgets (US dollars) --------------------------------------------------
# JARVIS steps down to a cheaper model at 70% of the daily budget and stops at 100%.
JARVIS_DAILY_BUDGET_USD=10
JARVIS_MONTHLY_BUDGET_USD=200
JARVIS_TASK_BUDGET_USD=2

# --- the real-run governor --------------------------------------------------
#
# Four ceilings on one `jarvis verify --real` sweep, because one of them is
# always the wrong one to have picked. Money is the obvious limit and the
# slowest to notice; a runaway retry hits the call count first, an agent that
# will not stop generating hits the token count first, and a hung provider hits
# the clock first. Whichever binds first stops the sweep, and the report names
# which one did.
#
# The defaults are deliberately small. `jarvis verify --real` reads like a
# status check and is in fact twenty-seven paid model calls.
JARVIS_REAL_VALIDATION_BUDGET_USD=1.0
JARVIS_REAL_RUN_MAX_CALLS=60
JARVIS_REAL_RUN_MAX_TOKENS=400000
JARVIS_REAL_RUN_TIMEOUT_SECONDS=1800

# --- execution -------------------------------------------------------------
JARVIS_MAX_PARALLEL_AGENTS=6
JARVIS_DEFAULT_AGENT_TIMEOUT_S=180
JARVIS_MAX_RETRIES_PER_TASK=2

# Risk level at and above which a human must approve: low | medium | high.
# Money, deploys and admin always require approval regardless of this setting.
JARVIS_REQUIRE_APPROVAL_ABOVE=medium
